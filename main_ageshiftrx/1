          ]);
      
          if (!$searchResponse->successful()) {
              return response()->json(['status' => 0, 'message' => 'Failed to search patients', 'error' => $searchResponse->body()]);
          }
      
          $patientData = $searchResponse->json();
          $patientId = $patientData[0]['patient_id'] ?? "";
      
          return response()->json([
              'status'     => 1,
              'data'       => $accessToken,
              'patientId'  => $patientId,
          ]);
    }



