    public function get_submission_data(Request $request)
    {
        $user_id = $request->user_id;
    
        if ($user_id != "") {
            $is_tab = DB::table('submissions')->where('user_id', $user_id)->first();
    
            if ($is_tab) {
                $submissions_id = $is_tab->submissions_id;
                $api_key = '06dce4a4f955cdcb79aa14bedb5350d5';
                $url = "https://forms.whitelabelmd.com/submission/{$submissions_id}?apiKey={$api_key}";
    
                // Get the HTML response
                $response = file_get_contents($url);
                if ($response === false) {
                    return response()->json(['error' => 'Failed to retrieve submission data'], 500);
                }
    
                // Load HTML into DOMDocument
                $dom = new \DOMDocument();
                libxml_use_internal_errors(true); // Suppress warnings for invalid HTML
                $dom->loadHTML($response);
                libxml_clear_errors();
    
                // Initialize data array with default values
                $result = [
                    'flags_requireimage_fullbody' => '0',
                ];
    
                // Retrieve case image data from database
                $case_img = DB::table('cases_images')->where('submissions_id', $submissions_id)->first();
                
                // Check if case image is not added
                if ($case_img && $case_img->is_add == 0) 
                {
                    $result['flags_requireimage_fullbody'] = '0';
                }
                elseif($case_img && $case_img->is_add == 1) 
                {
                    $result['flags_requireimage_fullbody'] = '0';
                }
                else 
                {
                    // Only proceed with row processing if is_add is not 0
                    $xpath = new \DOMXPath($dom);
                    $rows = $xpath->query("//tr");
    
                    foreach ($rows as $row) {
                        $cells = $row->getElementsByTagName('td');
    
                        if ($cells->length >= 2) {
                            $question = trim($cells->item(0)->textContent);
                            $answer = trim($cells->item(1)->textContent);
    
                            if ($question == '__flags_requireimage-fullbody') {
                                // Set 'flags_requireimage_fullbody' to '1' if answer is '1'
                                $result['flags_requireimage_fullbody'] = $answer === '1' ? '1' : $result['flags_requireimage_fullbody'];
                            }
                        }
                    }
                }
            }
            else
            {
                $result['status']       = 0;
                $result['message']      = "record not found!";
            }
        } else {
            $result['status'] = 0;
            $result['message'] = "Please fill out all the required details in the form before submitting it.";
        }
    
        return response()->json($result);
    }
    
    

