    public function add_new_cat_pro(Request $request)
    {
        $is_table = DB::table('category')->get();
    
        if (count($is_table) > 0)
        {
            $grouped_products = [];
            $base_names = [];
    
            // First pass: collect all potential base names
            foreach ($is_table as $data)
            {
                $is_pro_data = DB::table('product')->where('product_category_name', $data->category_name)->get();
    
                foreach($is_pro_data as $pr_data)
                {
                    $potential_base_name = $this->getPotentialBaseName($pr_data->product_name);
                    if (!in_array($potential_base_name, $base_names)) {
                        $base_names[] = $potential_base_name;
                    }
                }
            }
    
            // Sort base names by length in descending order to prioritize longer matches
            usort($base_names, function($a, $b) {
                return strlen($b) - strlen($a);
            });
    
            // Second pass: group products by base name
            foreach ($is_table as $data)
            {
                $is_pro_data = DB::table('product')->where('product_category_name', $data->category_name)->get();
    
                foreach($is_pro_data as $pr_data)
                {
                    $base_product_name = $this->getBaseProductName($pr_data->product_name, $base_names);
    
                    if (!isset($grouped_products[$base_product_name])) {
                        $grouped_products[$base_product_name] = [
                            'product_name' => $base_product_name,
                            'category_id' => $data->category_id
                        ];

                        $exists = DB::table('category_product')->where('category_product_name', $base_product_name)->exists();

                        if (!$exists) 
                        {
                            DB::table('category_product')->insert([
                                'category_product_name' => $base_product_name,
                                'category_id'           => $data->category_id,
                                'created_at'            => now(),
                            ]);
                        }
                    }
                }
            }
    
            $result = array_values($grouped_products);
    
            $response = [
                'status' => 1,
                'message' => "Congratulations! cat_pro added successfully.",
                // 'data' => $result
            ];
        }
        else
        {
            $response = [
                'status' => 0,
                'message' => "Something went wrong",
                'data' => []
            ];
        }
    
        return response()->json($response);
    }
    
    
    private function getPotentialBaseName($product_name)
    {
        // Clean up the product name to avoid partial matches
        $cleaned_name = preg_replace('/[^A-Za-z0-9\s]/', '', $product_name);
        $words = explode(' ', $cleaned_name);
        return implode(' ', array_slice($words, 0, 2)); // Use first two words as potential base name
    }
    
    private function getBaseProductName($product_name, $base_names)
    {
        // Clean up the product name to avoid partial matches
        $cleaned_name = preg_replace('/[^A-Za-z0-9\s]/', '', $product_name);
    
        foreach ($base_names as $base_name) {
            if (strpos($cleaned_name, $base_name) === 0) {
                return $base_name;
            }
        }
    
        // If no match found, return the first two words of the cleaned product name
        $words = explode(' ', $cleaned_name);
        return implode(' ', array_slice($words, 0, 2));
    }



    public function add_cat_pro_data(Request $request)
    {
        $categoryProducts = DB::table('category_product')->get();
        $result = [];
    
        if ($categoryProducts->isNotEmpty()) {
            foreach ($categoryProducts as $categoryProduct) {
                $categoryProductData = [];
    
                $categories = DB::table('category')->where('category_id', $categoryProduct->category_id)->get();
                $baseNames = [];
    
                foreach ($categories as $category) {
                    $products = DB::table('product')->where('product_category_name', $category->category_name)->get();
    
                    foreach ($products as $product) {
                        $potentialBaseName = $this->getPotentialBaseName($product->product_name);
                        if (!in_array($potentialBaseName, $baseNames)) {
                            $baseNames[] = $potentialBaseName;
                        }
    
                        usort($baseNames, function($a, $b) {
                            return strlen($b) - strlen($a);
                        });
    
                        $baseProductName = $this->getBaseProductName($product->product_name, $baseNames);
                        $month = $this->extractMonthFromProductName($product->product_name);
                        $quantity = $this->extractQuantityFromProductName($product->product_name);
                        $dosage = $this->extractDosageFromProductName($product->product_name);
    
                        if ($baseProductName === $categoryProduct->category_product_name) {
                            $exists = DB::table('category_product_data')->where('product_id', $product->product_id)->exists();
    
                            if (!$exists) {
                                $categoryProductData[] = [
                                    'category_product_id' => $categoryProduct->category_product_id,
                                    'product_id' => $product->product_id,
                                    'product_name' => $product->product_name,
                                    'dosage' => $dosage,
                                    'created_at' => date("Y-m-d H:i:s"),
                                ];
                            }
                        }
                    }
                }
    
                // Sort products by dosage before inserting
                usort($categoryProductData, function ($a, $b) {
                    return $this->compareDosage($a['dosage'], $b['dosage']);
                });
    
                foreach ($categoryProductData as $index => $data) {
                    $data['index'] = $index + 1;
    
                    DB::table('category_product_data')->insertGetId([
                        'category_product_id' => $data['category_product_id'],
                        'product_id' => $data['product_id'],
                        'index' => $data['index'],
                        'created_at' => $data['created_at'],
                    ]);
                }
            }
    
            $result = [
                'status' => 1,
                'message' => 'Data inserted successfully',
            ];
        } else {
            $result = [
                'status' => 0,
                'message' => "Something went wrong",
            ];
        }
    
        return response()->json($result);
    }
    
    // Helper function to compare dosages
    private function compareDosage($a, $b)
    {
        $a = (float) $a;
        $b = (float) $b;
    
        if ($a == $b) {
            return 0;
        }
    
        return ($a < $b) ? -1 : 1;
    }
    
    private function extractMonthFromProductName($productName)
    {
        if (preg_match('/(\d+)\s*month/', $productName, $matches)) {
            return (int)$matches[1];
        }
        if (preg_match('/(\d+)\s*Months/', $productName, $matches)) {
            return (int)$matches[1];
        }
        return null;
    }
    
    private function extractQuantityFromProductName($productName)
    {
        if (preg_match('/qty\s*(\d+)/', $productName, $matches)) {
            return (int)$matches[1];
        }
        if (preg_match('/(\d+)\s*Packs/', $productName, $matches)) {
            return (int)$matches[1];
        }
        return null;
    }
    
    private function extractDosageFromProductName($productName)
    {
        if (preg_match('/(\d*\.?\d+)\s*mg\/week/', $productName, $matches)) {
            return $matches[1];
        }

        if (preg_match('/(\d+)\s*mg/', $productName, $matches)) {
            return (int)$matches[1];
        }

        if (preg_match('/(\d+)\s*g/', $productName, $matches)) {
            return (int)$matches[1];
        }
        return null;
    }
    
    private function getDisplayKey($month, $quantity, $dosage)
    {
        if ($month && $quantity) {
            return  $quantity;
        } 
        elseif ($dosage && $month) 
        {
            return $dosage;
        } 
        elseif ($month) {
            return $month;
        } elseif ($quantity) {
            return  $quantity;
        }
        elseif ($dosage) 
        {
            return $dosage;
        } 
        else {
            return 'Unknown';
        }
    }


  

