    private function GetAllCoupons2()
    {
        // Check cache first for fast response
        if (Cache::has('all_coupons_data')) {
            return response()->json([
                'status' => 1,
                'message' => 'Coupons retrieved from cache.',
                'data' => Cache::get('all_coupons_data'),
            ]);
        }
        
        // Increase timeout for API calls
        $timeout = 10; // increased from 5 to 10 seconds
        
        try {
            $app_key_data = DB::table('app_keys')->first();
            $site_data = DB::table('site')->first();
        
            if (!$app_key_data || !$site_data) {
                \Log::error('API keys or site data not found');
                return response()->json([
                    'status' => 0,
                    'message' => 'API keys or site data not found.',
                ], 500);
            }
        
            $app_key = $app_key_data->app_key;
            $api_ext = $app_key_data->app_secret;
            $campaign_id = $site_data->campaign_id;
            
            // First API call to get coupon profiles
            $couponResponse = Http::timeout($timeout)
                ->withBasicAuth($app_key, $api_ext)
                ->withoutVerifying()
                ->get("https://whitelabelmd.sticky.io/api/v2/campaigns/{$campaign_id}");
            
            if (!$couponResponse->successful()) {
                \Log::error('Failed to retrieve coupon profiles', [
                    'status' => $couponResponse->status(),
                    'response' => $couponResponse->body()
                ]);
                return response()->json([
                    'status' => 0,
                    'message' => 'Failed to retrieve coupon profiles.',
                    'error' => $couponResponse->json(),
                ], $couponResponse->status());
            }
        
            // Extract coupon profiles
            $coupons = $couponResponse->json()['data']['coupon_profiles'] ?? [];
            
            if (empty($coupons)) {
                \Log::warning('No coupon profiles found');
                return response()->json([
                    'status' => 1,
                    'message' => 'No coupon profiles found.',
                    'data' => [],
                ]);
            }
            
            // Use curl_multi for parallel requests but with better handling
            $mh = curl_multi_init();
            $curlHandles = [];
            $responses = [];
            
            // Setup all curl requests in parallel
            foreach ($coupons as $coupon) {
                $couponId = $coupon['id'];
                $ch = curl_init();
                
                curl_setopt($ch, CURLOPT_URL, "https://whitelabelmd.sticky.io/api/v2/coupons/{$couponId}");
                curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                curl_setopt($ch, CURLOPT_USERPWD, "$app_key:$api_ext");
                curl_setopt($ch, CURLOPT_TIMEOUT, $timeout);
                curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
                curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
                
                curl_multi_add_handle($mh, $ch);
                $curlHandles[$couponId] = $ch;
            }
            
            // Execute all requests simultaneously with proper wait time
            $running = null;
            do {
                curl_multi_exec($mh, $running);
                if ($running) {
                    // Wait for activity on any curl_multi connection
                    curl_multi_select($mh, 0.1);
                }
            } while ($running > 0);
            
            // Process the results
            $finalCoupons = [];
            foreach ($curlHandles as $couponId => $ch) {
                $response = curl_multi_getcontent($ch);
                curl_multi_remove_handle($mh, $ch);
                
                $responseData = json_decode($response, true);
                if (isset($responseData['data']['promo_codes'])) {
                    $promo_codes = $responseData['data']['promo_codes'] ?? [];
                    
                    foreach ($promo_codes as $promo) {
                        $finalCoupons[] = [
                            'coupons_id' => $couponId,
                            'name' => $promo['code'],
                        ];
                    }
                }
            }
            
            curl_multi_close($mh);
            
            // Debug logging to help identify issues
            \Log::info('Coupon fetch completed', [
                'total_coupons_found' => count($finalCoupons),
                'coupon_names' => array_column($finalCoupons, 'name')
            ]);
            
            // Cache the results for faster subsequent requests (10 minutes)
            Cache::put('all_coupons_data', $finalCoupons, 600);
        
            return response()->json([
                'status' => 1,
                'message' => 'Coupons and their details retrieved successfully.',
                'data' => $finalCoupons,
            ]);
        } catch (\Exception $e) {
            \Log::error('Exception in GetAllCoupons2', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);
            return response()->json([
                'status' => 0,
                'message' => 'An error occurred while retrieving coupon data.',
                'error' => $e->getMessage(),
            ], 500);
        }
    }


    public function check_coupons(Request $request)
    {
        $promo_code = $request->promo_codes;
        $product_id = $request->product_id;
        $amount     = $request->amount;


        if (empty($promo_code) || empty($amount) || empty($product_id)) {
            return response()->json([
                'status' => 0,
                'message' => 'Please fill out all the required details in the form before submitting it.'
            ]);
        }
        $product_data = DB::table('product')->where('uniq_id',$product_id)->first();
        $product_description = $product_data->product_description;
        // dd($product_description);
        // Remove the "BM:..." part (including any whitespace before it)
        $bm = "";
        // Check if product_description has 'BM:' and extract number after it
        if (preg_match('/BM:(\d+)/', $product_data->product_description, $matches)) {
            $bm = (int) $matches[1];
        }
        // dd($bm);

       if ($promo_code == "SUMMER150" && $bm != 4) {
            return response()->json([
                'status' => 0,
                'message' => 'Promo code is not valid for this product.',
            ]);
        }

        if ($promo_code == "SUMMER100" && $bm != 3) {
            return response()->json([
                'status' => 0,
                'message' => 'Promo code is not valid for this product.',
            ]);
        }




        // dd($bm);
        // Check cache for this specific promo code
        $cache_key = 'promo_' . strtolower($promo_code) . '_' . $amount;
        if (Cache::has($cache_key)) {
            return Cache::get($cache_key);
        }

        try {
            // Call GetAllCoupons2 to fetch all coupons
            $coupon_check_response = $this->GetAllCoupons2();
            $coupon_data = $coupon_check_response->getData();

            if (!isset($coupon_data->data) || !is_array($coupon_data->data)) {
                \Log::error('Failed to get valid coupon data', ['response' => $coupon_data]);
                return response()->json([
                    'status' => 0,
                    'message' => 'Failed to fetch coupon data from API.',
                ]);
            }

            // Debug logging
            \Log::info('Checking promo code', [
                'promo_code' => $promo_code,
                'available_coupons_count' => count($coupon_data->data)
            ]);

            // Find the coupon that matches the promo code (faster direct loop with case insensitive comparison)
            $promo_code_lower = strtolower(trim($promo_code));
            $matching_coupon = null;

            foreach ($coupon_data->data as $coupon) {
                $coupon_name = strtolower(trim($coupon->name));
                if ($coupon_name === $promo_code_lower) {
                    $matching_coupon = $coupon;
                    \Log::info('Found matching coupon', ['coupon' => $coupon]);
                    break; // Exit loop as soon as we find a match
                }
            }

            if (!$matching_coupon) {
                // If no direct match, try a second attempt with fresh data
                Cache::forget('all_coupons_data');
                $coupon_check_response = $this->GetAllCoupons2();
                $coupon_data = $coupon_check_response->getData();

                if (isset($coupon_data->data) && is_array($coupon_data->data)) {
                    foreach ($coupon_data->data as $coupon) {
                        $coupon_name = strtolower(trim($coupon->name));
                        if ($coupon_name === $promo_code_lower) {
                            $matching_coupon = $coupon;
                            \Log::info('Found matching coupon on second attempt', ['coupon' => $coupon]);
                            break;
                        }
                    }
                }

                if (!$matching_coupon) {
                    $response = response()->json([
                        'status' => 0,
                        'message' => 'Promo code does not exist in the available coupons.',
                    ]);
                    Cache::put($cache_key, $response, 300); // Cache negative results too
                    return $response;
                }
            }

            $coupon_id = $matching_coupon->coupons_id;

            // Check if we have cached details for this coupon ID
            $coupon_details_key = 'coupon_details_' . $coupon_id;
            $responseData = null;

            if (Cache::has($coupon_details_key)) {
                $responseData = Cache::get($coupon_details_key);
            } else {
                // Fetch app key and secret from the database
                $app_key_data = DB::table('app_keys')->first();
                if (!$app_key_data) {
                    return response()->json([
                        'status' => 0,
                        'message' => 'API configuration not found.',
                    ]);
                }

                $app_key = $app_key_data->app_key;
                $app_secret = $app_key_data->app_secret;

                // Use direct curl for faster response but with increased timeout
                $ch = curl_init();
                curl_setopt($ch, CURLOPT_URL, "https://whitelabelmd.sticky.io/api/v2/coupons/{$coupon_id}");
                curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                curl_setopt($ch, CURLOPT_USERPWD, "$app_key:$app_secret");
                curl_setopt($ch, CURLOPT_TIMEOUT, 10); // Increased timeout
                curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
                curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);

                $curl_response = curl_exec($ch);
                $httpcode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
                curl_close($ch);

                if ($httpcode != 200 || !$curl_response) {
                    \Log::error('Coupon details API failed', [
                        'code' => $httpcode,
                        'response' => $curl_response
                    ]);
                    return response()->json([
                        'status' => 0,
                        'message' => 'Failed to retrieve coupon details from the external service.',
                    ]);
                }

                $responseData = json_decode($curl_response, true);

                // Cache the coupon details for 10 minutes
                if (isset($responseData['data'])) {
                    Cache::put($coupon_details_key, $responseData, 600);
                }
            }

            if (!isset($responseData['data'])) {
                return response()->json([
                    'status' => 0,
                    'message' => 'Invalid response format from API.',
                ]);
            }

            // Check expiration
            $expires_at_data = $responseData['data']['expires_at'] ?? null;
            if ($expires_at_data) {
                $expires_at = Carbon::parse($expires_at_data['date'], $expires_at_data['timezone']);
                $current_time = Carbon::now($expires_at_data['timezone']);

                if ($current_time->greaterThan($expires_at)) {
                    $response = response()->json([
                        'status' => 0,
                        'message' => 'Coupon has expired and is no longer valid.',
                    ]);
                    Cache::put($cache_key, $response, 300);
                    return $response;
                }
            }

            // Get coupon details
            $discount_percent = $responseData['data']['discount_pct'] ?? "0.00";
            $discount_amount = $responseData['data']['discount_amt'] ?? "0.00";
            $minimum_purchase = $responseData['data']['minimum_purchase'] ?? "0.00";
            $use_count = $responseData['data']['use_count'] ?? "0.00";
            $limit = $responseData['data']['limits']['total'] ?? null;

            $promo_code_data = [
                "id" => $responseData['data']['id'] ?? null,
                "use_count" => $use_count,
                "code" => $promo_code,
                "is_active" => $responseData['data']['is_active'] ?? 0,
                "is_deleted" => $responseData['data']['is_deleted'] ?? 0,
                "created_at" => $responseData['data']['created_at'] ?? null,
                "created_by" => $responseData['data']['created_by'] ?? null,
            ];

            // Check if the amount meets the minimum purchase requirement
            if ($amount < $minimum_purchase) {
                $response = response()->json([
                    'status' => 0,
                    'message' => 'The entered amount does not meet the minimum purchase requirement.',
                    'minimum_purchase' => $minimum_purchase,
                ]);
                // Cache::put($cache_key, $response, 300);
                return $response;
            }

              if ($amount < $discount_amount) {
                $response = response()->json([
                    'status' => 0,
                    'message' => 'The entered amount does not meet the discount amt requirement.',
                    'minimum_purchase' => $minimum_purchase,
                ]);
                // Cache::put($cache_key, $response, 300);
                return $response;
            }

            // Check if the limit has been reached
            if ($limit !== null && $use_count >= $limit) {
                $response = response()->json([
                    'status' => 0,
                    'message' => 'Coupon not valid as limit has been reached.',
                ]);
                // Cache::put($cache_key, $response, 300);
                return $response;
            }

            // Everything is valid
            $response = response()->json([
                'status' => 1,
                'message' => 'Promo code matches successfully and is applicable.',
                'data' => $promo_code_data,
                'discount_percent' => $discount_percent,
                'discount_amount' => $discount_amount,
                'minimum_purchase' => $minimum_purchase,
                'limit' => $limit,
            ]);

            // Cache successful response
            Cache::put($cache_key, $response, 300);
            return $response;

        } catch (\Exception $e) {
            \Log::error('Exception in check_coupons', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);
            return response()->json([
                'status' => 0,
                'message' => 'An error occurred while checking the coupon.',
                'error' => $e->getMessage(),
            ], 500);
        }
    }

    public function get_url_data(Request $request)
    {
        $encodedData = $request->data;
    
        if (!empty($encodedData)) 
        {
                  // Decode the Base64-encoded string
            $decodedData = base64_decode($encodedData);
        
            if ($decodedData === false) {
                return response()->json([
                    'status' => 0,
                    'message' => 'Invalid Base64 data',
                ]);
            }
        
            
            // Parse the decoded data (assuming it's URL query string format)
            parse_str($decodedData, $parsedData);
            if (isset($parsedData['phone'])) {
                $parsedData['phone'] = $this->formatPhoneNumber($parsedData['phone']);
            }
            return response()->json([
                'status' => 1,
                'message' => 'Data decoded successfully',
                'decoded_data' => $parsedData,
            ]);
        }
        else
        {
            return response()->json([
                'status' => 0,
                'message' => 'Please provide a valid data.',
            ]);
        }
  
    }

    // Helper function to format phone numbers
    private function formatPhoneNumber($phone)
    {
        // Remove all non-numeric characters
        return preg_replace('/\D/', '', $phone);
    }

