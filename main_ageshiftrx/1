    public function fetchAndStoreStates(Request $request)
    {
        // Fetch the API response
        $apiUrl = 'https://whitelabelmd.jotform.com/API/form/241624196662864/questions?apiKey=06dce4a4f955cdcb79aa14bedb5350d5';
        $response = Http::get($apiUrl);
    
        // Check if the request was successful
        if ($response->successful()) {
            $data = $response->json();
    
            // Extract the state options from the response
            $stateOptions = $data['content']['226']['options'];
            $states = explode('|', $stateOptions);
    
            // Insert each state into the database
            foreach ($states as $state) {
                $state = trim($state); // Remove any leading/trailing whitespace including tabs
    
                // Clean any tab characters
                $state = str_replace("\t", ' ', $state);
    
                // Extract state name and abbreviation
                if (preg_match('/^(.*) \((.*)\)$/', $state, $matches)) {
                    $stateName = trim($matches[1]);
                    $stateAbbreviation = trim($matches[2]);
    
                       // Check if the state name already exists in the database
                    $existingState = DB::table('states')->where('name', $stateName)->first();
                    if (!$existingState) {
                        // Insert into the database
                        DB::table('states')->insert([
                            'name'         => $stateName,
                            'form_id'      => 241624196662864,
                            'abbreviation' => $stateAbbreviation,
                        ]);
                    }
                } else {
                    // Handle cases where the pattern does not match
                    return response()->json(['message' => 'Failed to parse state: ' . $state], 500);
                }
            }
    
            return response()->json(['message' => 'States inserted successfully!']);
        } else {
            return response()->json(['message' => 'Failed to fetch API data'], 500);
        }
    }
    


    


