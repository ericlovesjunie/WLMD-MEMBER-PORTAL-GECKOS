    public function sendWebhook(Request $request, $site_id)
    {
        // Define validation rules
        $rules = [
            'unique_id' => 'required|string',
            'email' => 'required|email',
            'status' => 'required|in:clicked,complete',
            'order_id' => 'nullable|string',
            'therapy' => 'nullable|string',
            'form_id' => 'nullable|string',
        ];

        // Create a validator instance
        $validator = Validator::make($request->all(), $rules);

        // Check if validation fails
        if ($validator->fails()) {
            return response()->json([
                'message' => 'Validation failed',
                'errors' => $validator->errors()
            ], 422);
        }

        // If validation passes, get the validated data
        $validatedData = $validator->validated();

        // Prepare the data to be sent
        $data = [
            'unique_id' => $validatedData['unique_id'],
            'email' => $validatedData['email'],
            'status' => $validatedData['status'],
            'source' => 'memberportal', // Hardcoded as specified
            'order_id' => $validatedData['order_id'] ?? null,
            'therapy' => $validatedData['therapy'] ?? null,
            'form_id' => $validatedData['form_id'] ?? null,
        ];

        // Remove null values
        $data = array_filter($data, function ($value) {
            return $value !== null;
        });

        // Send the POST request to the webhook URL
        try {
            $response = Http::post("https://api.whitelabelmd.com/webhook/intake-completed-px/{$site_id}/", $data);

            // Check if the request was successful
            if ($response->successful()) {
                return response()->json(['message' => 'Data sent to webhook successfully'], 200);
            } else {
                return response()->json([
                    'message' => 'Failed to send data to webhook',
                    'error' => $response->body()
                ], $response->status());
            }
        } catch (\Exception $e) {
            return response()->json([
                'message' => 'An error occurred while sending data to webhook',
                'error' => $e->getMessage()
            ], 500);
        }
    }

   

