    public function handleWebhook(Request $request)
    {
        // Filter out fields with data:image in their value
        $filteredData = array_filter($request->all(), function ($value) {
            return strpos($value, 'data:image') === false;
        });
    
        // Convert the filtered data to a JSON string
        $requestData = json_encode($filteredData);
    
        // Decode the JSON string to access the data as an object
        $decodedData = json_decode($requestData);
    
        // Extract the user_id from the 'pretty' field
        $pretty = $decodedData->pretty ?? '';
        preg_match('/user_id:(\d+)/', $pretty, $matches);
        $userId = $matches[1] ?? null;
    
        // Insert the filtered data into the 'webhook' table
        DB::table('webhook')->insert([
            'webhook_data' => $requestData,
            'user_id' => $userId,
            'created_at' => now(),
            'updated_at' => now(),
        ]);
    
        $result['data'] = $requestData;
        $result['status'] = 1;
        $result['message'] = "Success";
    
        return response()->json($result);
    }

