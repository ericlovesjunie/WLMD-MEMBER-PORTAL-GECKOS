    public function subscription_stop(Request $request)
    {
        $order_id = $request->order_id;

        if (empty($order_id)) {
            return response()->json([
                'status' => 0,
                'message' => "Please provide a valid order ID."
            ]);
        }

        // Fetch order data first
        $orderResponse = $this->Orderdataget($order_id);
        $orderData = json_decode($orderResponse->getContent(), true); // Convert JSON response to an array

        if ($orderData['status'] === 0 || empty($orderData['data']['products'])) {
            return response()->json([
                'status' => 0,
                'message' => "Order data not found or invalid."
            ]);
        }

        // Extract subscription_id from the first product (assuming all products share the same subscription ID)
        $subscription_id = $orderData['data']['products'][0]['subscription_id'] ?? null;
// dd($subscription_id);
        if (empty($subscription_id)) {
            return response()->json([
                'status' => 0,
                'message' => "No subscription found for the given order."
            ]);
        }

        // Get API credentials
        $app_key_data = DB::table('app_keys')->first();
        $app_key    = $app_key_data->app_key;
        $app_secret = $app_key_data->app_secret;

        // Make API call to stop the subscription
        $response = Http::withBasicAuth($app_key, $app_secret)
                        ->post("https://whitelabelmd.sticky.io/api/v2/subscriptions/{$subscription_id}/stop");

        $responseData = $response->json();
// dd($responseData);
        if ($response->successful()) {
            return response()->json([
                'status' => 1,
                'subscription_id' => $subscription_id,
                'message' => 'Subscription stopped successfully.',
                'data' => $responseData
            ]);
        } else {
            return response()->json([
                'status' => 0,
                'message' => 'Failed to stop subscription.',
                'error' => $responseData
            ]);
        }
    }


    
    

    
    
    
 


